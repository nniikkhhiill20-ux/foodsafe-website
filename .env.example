# Postgres connection string.
# On Railway, add a Postgres plugin and this is provided automatically as DATABASE_URL.
DATABASE_URL=postgresql://user:password@localhost:5432/foodsafe

# Set to "true" to force SSL (needed for some external Postgres hosts).
# Railway's internal connection does NOT need this.
DATABASE_SSL=false

# Seed the database with sample restaurants + reviews on first boot (empty DB only).
SEED_ON_START=true

# Admin console credentials (protects /admin and /api/admin/*).
ADMIN_USER=admin
ADMIN_PASS=change-me-please

# Port (Railway sets this automatically).
PORT=3000
